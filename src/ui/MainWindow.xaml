<Window x:Class="WorkBuddyUnlock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="800" Height="860" MinWidth="640" MinHeight="800" WindowStartupLocation="CenterScreen"
 Background="#F3F6F7" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#24343D"
 UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="unlock.ico">
 <Grid Margin="24,18,24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- 实时同步状态：由 CLI 的内容比对（pendingChanges）得出结论，不是提醒文案。
       需要应用时配色为告警橙，已同步时转为平静的绿色，无需读文字也能一眼分辨。 -->
  <Border Grid.Row="0" CornerRadius="8" Padding="14,12" Margin="0,0,0,12"
    AutomationProperties.AutomationId="SyncBanner"
    Background="{Binding NeedApply, Converter={StaticResource SyncBg}}"
    BorderBrush="{Binding NeedApply, Converter={StaticResource SyncBorder}}">
   <StackPanel>
    <TextBlock Text="{Binding SyncHeadline}" FontWeight="Bold" TextWrapping="Wrap"
      AutomationProperties.AutomationId="SyncHeadline"
      Foreground="{Binding NeedApply, Converter={StaticResource SyncFg}}"/>
    <TextBlock Text="{Binding SyncDetail}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
      AutomationProperties.AutomationId="SyncDetail"
      Foreground="{Binding NeedApply, Converter={StaticResource SyncFg}}" Opacity="0.85"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="1" Background="White" BorderBrush="#DCE4E7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="目标安装" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ItemsControl ItemsSource="{Binding Installs}" IsEnabled="{Binding IsIdle}" AutomationProperties.AutomationId="Installs">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <StackPanel Margin="0,0,0,8">
        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}">
         <CheckBox.ToolTip><TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="640"/></CheckBox.ToolTip>
         <!-- 用可换行的 TextBlock 而不是字符串 Content：安装路径可能很长，
              窄窗口（最小宽度 640）下字符串 Content 不换行，会被硬切且无省略号。 -->
         <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
        </CheckBox>
        <!-- 版本行：当前客户端版本 + 上次应用版本（指纹只显示到版本号，完整值悬停可见）。
             两者不一致时染成告警色，说明客户端升级过、需要重新应用。 -->
        <TextBlock Margin="24,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
          AutomationProperties.AutomationId="InstallVersion"
          Text="{Binding VersionLine}" ToolTip="{Binding VersionTooltip}">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Foreground" Value="#647680"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding VersionMismatch}" Value="True">
             <Setter Property="Foreground" Value="#B45309"/>
             <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="默认全部勾选。每套安装有各自的配置目录（国内版 ~/.workbuddy，AI 版 ~/.workbuddy-ai），插件缓存是独立副本，两边都要同步。"
     FontSize="12" Foreground="#647680" TextWrapping="Wrap" Margin="0,6,0,10"/>
    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="Status"/>
    <TextBlock Text="{Binding InstallSummary}" Foreground="#647680" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <CheckBox Content="允许完全访问（新任务不再逐条确认）"
     IsChecked="{Binding FullAccess}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,4" AutomationProperties.AutomationId="FullAccess"/>
    <StackPanel Orientation="Horizontal" Margin="24,0,0,8">
     <TextBlock Text="客户端当前：" FontSize="12" Foreground="#647680"/>
     <TextBlock Text="{Binding FullAccessOnDisk}" FontSize="12" Foreground="#647680" AutomationProperties.AutomationId="FullAccessOnDisk"/>
     <TextBlock Text=" · 勾选会被记住；取消勾选只是“本次不改”，不会把已开启的关掉" FontSize="12" Foreground="#647680"/>
    </StackPanel>
    <CheckBox Content="同时放开本地安全配置（沙箱、文件/命令/网络规则、程序黑名单）"
     IsChecked="{Binding IncludeSecurity}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,2" AutomationProperties.AutomationId="Security"/>
    <TextBlock Text="取消勾选不会把已关闭的开关恢复回去，也不改动凭据检测。"
     FontSize="12" Foreground="#647680" TextWrapping="Wrap" Margin="24,0,0,10"/>
    <WrapPanel>
     <Button Content="一键应用" Command="{Binding ApplyCommand}" Background="{Binding NeedApplyHighlight, Converter={StaticResource ApplyAccent}}" Foreground="White" BorderBrush="{Binding NeedApplyHighlight, Converter={StaticResource ApplyAccent}}" AutomationProperties.AutomationId="Apply"/>
     <Button Content="预览" Command="{Binding PreviewCommand}" AutomationProperties.AutomationId="Preview"/>
     <Button Content="撤销上次应用" Command="{Binding RestoreCommand}" AutomationProperties.AutomationId="Restore"/>
    </WrapPanel>
    <TextBlock Text="应用/撤销会自动关闭并重启 WorkBuddy，请先保存工作。凭据检测保持不变。"
     FontSize="12" Foreground="#647680" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="White" BorderBrush="#DCE4E7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="修改提示词" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox ItemsSource="{Binding PromptFiles}" SelectedItem="{Binding SelectedPrompt}" IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center" Margin="0,0,10,0">
      <!-- 最长标签（“Agent / Expert 内容策略 · content_policy.craft-expert.txt”≈440px）
           超出最小窗口（640px）的可用宽度，默认字符串渲染会被硬切且无省略号。
           用带省略号 + 悬停全称的模板，短标签不受影响。 -->
      <ComboBox.ItemTemplate>
       <DataTemplate>
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis">
         <TextBlock.ToolTip><TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="560"/></TextBlock.ToolTip>
        </TextBlock>
       </DataTemplate>
      </ComboBox.ItemTemplate>
     </ComboBox>
     <Button Grid.Column="1" Content="编辑文件" Command="{Binding EditCommand}" AutomationProperties.AutomationId="Edit"/>
     <Button Grid.Column="2" Content="打开目录" Command="{Binding FolderCommand}" Margin="0"/>
    </Grid>
    <TextBlock Text="保存为 UTF-8，保留段落标签；修改后点击“一键应用”，无需先还原。"
     FontSize="12" Foreground="#647680" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </StackPanel>
  </Border>
  <TextBox Grid.Row="3" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
    TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#FFFFFF" BorderBrush="#DCE4E7"
    Padding="12" MinHeight="90" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" AutomationProperties.AutomationId="Log"/>
  <TextBlock Grid.Row="4" Text="只改解包文件，不重新打包 app.asar。提示词约束不等于系统调用硬拦截。"
    Foreground="#647680" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </Grid>
</Window>
