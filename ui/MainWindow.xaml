<Window x:Class="WorkBuddyUnlock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WorkBuddy Prompt Unlock"
 Width="800" Height="860" MinWidth="640" MinHeight="800" WindowStartupLocation="CenterScreen"
 Background="#F3F6F7" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#24343D"
 UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="unlock.ico">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="WorkBuddy Prompt Unlock" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="本地提示词管理 · 修改文件后，一键同步到客户端" Foreground="#647680" Margin="0,5,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#FFF4E5" BorderBrush="#E8A33D" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12"
    AutomationProperties.AutomationId="UpgradeNotice">
   <StackPanel>
    <TextBlock Text="⚠  WorkBuddy 升级后，请回来重新点一次“一键应用”" FontWeight="Bold" Foreground="#8A5300" TextWrapping="Wrap"/>
    <TextBlock Text="升级会重新解包并覆盖模板，同时清掉旧版本插件缓存，提示词改动会失效。重新应用后对新版本生效。"
     FontSize="12" Foreground="#8A5300" TextWrapping="Wrap" Margin="0,5,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="White" BorderBrush="#DCE4E7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="目标安装" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ItemsControl ItemsSource="{Binding Installs}" IsEnabled="{Binding IsIdle}" AutomationProperties.AutomationId="Installs">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Content="{Binding Label}" Margin="0,0,0,4">
        <CheckBox.ToolTip><TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="640"/></CheckBox.ToolTip>
       </CheckBox>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="默认全部勾选。每套安装有各自的配置目录（国内版 ~/.workbuddy，AI 版 ~/.workbuddy-ai），插件缓存是独立副本，两边都要同步。"
     FontSize="12" Foreground="#647680" TextWrapping="Wrap" Margin="0,6,0,10"/>
    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="Status"/>
    <TextBlock Text="{Binding InstallSummary}" Foreground="#647680" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <CheckBox Content="允许完全访问（新任务不再逐条确认，默认开启）"
     IsChecked="{Binding FullAccess}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,8" AutomationProperties.AutomationId="FullAccess"/>
    <CheckBox Content="同时放开本地安全配置（沙箱、文件/命令/网络规则、程序黑名单）"
     IsChecked="{Binding IncludeSecurity}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,10" AutomationProperties.AutomationId="Security"/>
    <WrapPanel>
     <Button Content="一键应用" Command="{Binding ApplyCommand}" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}" AutomationProperties.AutomationId="Apply"/>
     <Button Content="预览" Command="{Binding PreviewCommand}" AutomationProperties.AutomationId="Preview"/>
     <Button Content="撤销上次应用" Command="{Binding RestoreCommand}" AutomationProperties.AutomationId="Restore"/>
    </WrapPanel>
    <TextBlock Text="应用/撤销会自动关闭并重启 WorkBuddy，请先保存工作。凭据检测保持不变。"
     FontSize="12" Foreground="#647680" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="3" Background="White" BorderBrush="#DCE4E7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="修改提示词" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox ItemsSource="{Binding PromptFiles}" SelectedItem="{Binding SelectedPrompt}" DisplayMemberPath="Label" IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
     <Button Grid.Column="1" Content="编辑文件" Command="{Binding EditCommand}" AutomationProperties.AutomationId="Edit"/>
     <Button Grid.Column="2" Content="打开目录" Command="{Binding FolderCommand}" Margin="0"/>
    </Grid>
    <TextBlock Text="保存为 UTF-8，保留段落标签；修改后点击“一键应用”，无需先还原。"
     FontSize="12" Foreground="#647680" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </StackPanel>
  </Border>
  <TextBox Grid.Row="4" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
    TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#FFFFFF" BorderBrush="#DCE4E7"
    Padding="12" MinHeight="90" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" AutomationProperties.AutomationId="Log"/>
  <TextBlock Grid.Row="5" Text="只改解包文件，不重新打包 app.asar。提示词约束不等于系统调用硬拦截。"
    Foreground="#647680" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </Grid>
</Window>
